#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        // ZMK v0.3's documented timeless home row mods, with Toucan positions.
        // https://zmk.dev/docs/keymaps/behaviors/hold-tap#custom-hold-tap-examples
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Home row mod left";
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Home row mod right";
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };

        // Original Graphite Shift pairs, triggered by either Shift key.
        // https://github.com/rdavison/graphite-layout#ascii-version
        // https://zmk.dev/docs/keymaps/behaviors/mod-morph
        quote_pair: quote_pair {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "apostrophe / underscore";
            bindings = <&kp SQT>, <&kp UNDER>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_pair: comma_pair {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "comma / question mark";
            bindings = <&kp COMMA>, <&kp QMARK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        minus_pair: minus_pair {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "minus / double quote";
            bindings = <&kp MINUS>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        slash_pair: slash_pair {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "slash / less than";
            bindings = <&kp FSLH>, <&kp LT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB   &kp B       &kp L       &kp D        &kp W        &kp Z   &quote_pair &kp F        &kp O        &kp U       &kp J           &kp SEMI
                &mt LCTRL ESC &hml LGUI N &hml LALT R &hml LCTRL T &hml LSHFT S &kp G   &kp Y           &hmr RSHFT H &hmr RCTRL A &hmr RALT E &hmr RGUI I     &comma_pair
                &kp LSHFT &kp Q       &kp X       &kp M        &kp C        &kp V   &kp K           &kp P        &kp DOT      &minus_pair &slash_pair &tog 5
                                                &kp BSPC     &mo 1        &kp SPACE   &kp SPACE &mo 2 &kp RET
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &kp TAB     &kp N1          &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
                &bt BT_CLR  &bt BT_SEL 0    &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
                &kp LSHFT   &studio_unlock  &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                                &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
                &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
                &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                                          &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &kp TAB   &trans &kp F7 &kp F8 &kp F9 &kp F12   &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP &trans &trans &kp BSPC
                &kp LCTRL &trans &kp F4 &kp F5 &kp F6 &kp F11   &trans       &trans      &trans       &trans &trans &trans
                &kp LSHFT &trans &kp F1 &kp F2 &kp F3 &kp F10   &trans       &trans      &trans       &trans &trans &trans
                                   &kp LGUI &mo 1 &kp SPACE   &kp RET &mo 2 &kp RALT
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp MCLK &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        game {
            display-name = "GAME";
            // Above MOU so trackpad contact does not replace the gaming thumbs.
            bindings = <
                &kp TAB      &none &kp Q &kp W &kp E &kp R   &trans &trans &trans    &trans &trans &trans
                &mt LCTRL ESC &kp LSHFT &kp A &kp S &kp D &kp F   &trans &kp J  &mkp LCLK &kp L  &trans &trans
                &kp LSHFT    &none &kp Z &kp X &kp C &kp V   &trans &trans &trans    &trans &trans &tog 5
                                     &kp BSPC &none &kp SPACE   &mkp RCLK &none &kp RET
            >;
        };

        extra_3 {
                status = "reserved";
        };
    };
};
